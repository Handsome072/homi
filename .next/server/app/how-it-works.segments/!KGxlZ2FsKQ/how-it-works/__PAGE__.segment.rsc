0:{"buildId":"qD5QTEv_t6R_rowJ89dMM","rsc":["$","$1","c",{"children":[[["$","div",null,{"className":"px-6 lg:px-20 py-12","children":["$","div",null,{"className":"max-w-[640px] mx-auto","children":[["$","h1",null,{"className":"text-[28px] mb-10","style":{"fontWeight":400,"color":"#484848","lineHeight":"1.3"},"children":"Fonctionnement du site et classement des annonces"}],["$","div",null,{"className":"space-y-10","children":[["$","section",null,{"children":[["$","h2",null,{"className":"text-base mb-4","style":{"fontWeight":700,"color":"#484848"},"children":"QU'EST-CE QU'HOMIQIO ?"}],["$","div",null,{"className":"space-y-4 text-base","style":{"color":"#484848","lineHeight":"1.6"},"children":[["$","p",null,{"children":["La Plateforme HOMIQIO est une place de marché en ligne qui permet aux utilisateurs enregistrés (les ",["$","strong",null,{"children":"« Membres »"}],") et à certains tiers qui proposent des services (les Membres et tiers qui proposent des services sont des ",["$","strong",null,{"children":"« Hôtes »"}]," et les services qu'ils proposent sont des ",["$","strong",null,{"children":"« Services d'Hôte »"}],") de publier ces Services d'Hôte sur la Plateforme HOMIQIO (les ",["$","strong",null,{"children":"« Annonces »"}],") et de communiquer et traiter directement avec des Membres qui souhaitent réserver ces Services d'Hôte (les Membres qui utilisent des Services d'Hôte sont des ",["$","strong",null,{"children":"« Voyageurs »"}],"). Les Services d'Hôte peuvent comprendre la location de logements pour des vacances ou autre usage (les ",["$","strong",null,{"children":"« Hébergements »"}],"), des activités sur une ou plusieurs journées dans différentes catégories (les ",["$","strong",null,{"children":"« Expériences »"}],"), un accès à des événements et lieux uniques (les ",["$","strong",null,{"children":"« Événements »"}],"), ainsi que d'autres services variés, en lien ou non avec les voyages."]}],["$","p",null,{"children":"Vous devez créer un compte pour pouvoi